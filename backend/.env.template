GEMINI_API_KEY=...
MODEL=gemini-3.5-flash-lite
MODEL_PROVIDER=google_genai
# Optional Google reasoning level; unset uses the provider default.
# MODEL_THINKING_LEVEL=medium
# Original PDF input support for the configured model.
MODEL_PDF_INPUT=true
# Local scheduling limits (positive integers); use your provider/project allowance.
MODEL_RPM=15
MODEL_TPM=250000
MODEL_CONTEXT_TOKENS=1048576
PORT=3001
MCP_SERVER_URL=http://localhost:8080
FRONTEND_ORIGIN=http://localhost:5173
# Saved runs and source cache. Defaults to $XDG_DATA_HOME/jigsaw or ~/.local/share/jigsaw.
# DATA_DIR=/path/to/jigsaw-data
